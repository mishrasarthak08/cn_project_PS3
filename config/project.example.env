# ---------------------------------------------------------------------------
# Central project settings. Every script reads these through scripts/common.sh.
# Precedence: process environment > ~/.config/cn-phase1/project.env > this file.
# Setup scripts ask for missing values on first run and save them to the
# user file (chmod 600). Do not duplicate these constants anywhere else.
# ---------------------------------------------------------------------------

TEAM=team1                       # -> app.team1.test / api.team1.test
NETWORK_MODE=lan                 # lan | tunnel
ROLE=                            # sarthak | preetish | shitanshu | shane (saved by setup)

# --- LAN addresses (Task A). Fill in during setup. -------------------------
DNS_IP=10.7.7.126                         # Mac 1 (Sarthak) private IP
EDGE_IP=10.7.11.189                        # Mac 2 (Preetish) private IP
SHITANSHU_LAN_IP=10.7.7.23                # Mac 3 private IP (lan mode upstream)
SHANE_LAN_IP=10.7.14.16                   # Mac 4 private IP (lan mode upstream)

# --- Ports ----------------------------------------------------------------
DNS_PORT=53
EDGE_PORT=8443                   # 443 needs root; 8443 is allowed by the brief
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002

# --- Tunnel mode (Cloudflare Zero Trust private network) ------------------
TUNNEL_EDGE_IP=10.250.0.2        # virtual IP routed to Preetish's edge tunnel
TUNNEL_EDGE_NAME=cn-edge
TUNNEL_A_IP=10.250.0.3           # virtual IP routed to Shitanshu's tunnel
TUNNEL_B_IP=10.250.0.4           # virtual IP routed to Shane's tunnel
TUNNEL_A_NAME=cn-backend-a
TUNNEL_B_NAME=cn-backend-b

# --- Backend identity -----------------------------------------------------
BACKEND_A_OWNER=Shitanshu
BACKEND_B_OWNER=Shane

# --- nginx behaviour ------------------------------------------------------
UPSTREAM_MAX_FAILS=1
UPSTREAM_FAIL_TIMEOUT=5s
UPSTREAM_CONNECT_TIMEOUT=2s

# --- Test behaviour -------------------------------------------------------
LB_SAMPLE_REQUESTS=8
# 1 = resolve names through the macOS resolver (real demo).
# 0 = single-machine simulation only (uses dig + curl --resolve).
TEST_USE_SYSTEM_RESOLVER=1

# --- DNS ------------------------------------------------------------------
DNS_TTL=300                      # seconds; Extension B: set to 30 for the TTL demo
